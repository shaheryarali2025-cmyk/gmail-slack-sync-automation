    {
      "parameters": {
        "jsCode": "const payload = JSON.parse($json.body.payload);\n\nconst rawMeta =\n  payload.actions?.[0]?.value ||\n  payload.view?.private_metadata ||\n  \"{}\";\n\nlet meta = {};\n\ntry {\n  meta = JSON.parse(rawMeta);\n} catch (error) {\n  meta = {\n    account: \"awais_mail\",\n    message_id: rawMeta,\n  };\n}\n\nconst replyText =\n  payload.view?.state?.values?.reply_block?.reply_text?.value || \"\";\n\n// Slack message/channel info for reaction\nconst slackChannelId =\n  payload.channel?.id ||\n  payload.container?.channel_id ||\n  meta.channel_id ||\n  \"\";\n\nconst slackMessageTs =\n  payload.container?.message_ts ||\n  payload.message?.ts ||\n  meta.message_ts ||\n  \"\";\n\nreturn [\n  {\n    json: {\n      slack_type: payload.type,\n      trigger_id: payload.trigger_id || \"\",\n      account: meta.account || \"awais_mail\",\n      gmail_message_id: meta.message_id || \"\",\n      reply_text: replyText,\n      user_id: payload.user?.id || \"\",\n      response_url: payload.response_url || \"\",\n      slack_channel_id: slackChannelId,\n      slack_message_ts: slackMessageTs,\n    },\n  },\n];"
      },
